# This file is an operator reference; the server does not load dotenv automatically.
GAME_CANVAS_HOST=127.0.0.1
GAME_CANVAS_PORT=4317
# PORT is used only when GAME_CANVAS_PORT is unset (e.g. Render).
GAME_CANVAS_DATA=./collaboration-data
GAME_CANVAS_PUBLIC=0
GAMEJAM_SERVICE_MODE=self-host
# Required: >=32 random characters when public/non-loopback or managed-beta.
GAME_CANVAS_SERVER_KEY=
GAMEJAM_SHUTDOWN_MS=25000
# Empty by default. Only operator-verified proxy IPs/CIDRs; never all networks.
GAMEJAM_TRUSTED_PROXIES=
# Optional: fill all values to enable private external S3-compatible backups.
# GAMEJAM_BACKUP_S3_ENDPOINT=https://storage.example.invalid
# GAMEJAM_BACKUP_S3_REGION=us-east-1
# GAMEJAM_BACKUP_S3_BUCKET=
# GAMEJAM_BACKUP_S3_PREFIX=game-jam/
# GAMEJAM_BACKUP_S3_ACCESS_KEY_ID=
# GAMEJAM_BACKUP_S3_SECRET_ACCESS_KEY=
